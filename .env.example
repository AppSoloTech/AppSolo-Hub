# Local Compose only. Do not use these values outside local development.
POSTGRES_USER=appsolo
POSTGRES_PASSWORD=appsolo_local_only
POSTGRES_DB=appsolo_client_hub_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://appsolo:appsolo_local_only@localhost:5432/appsolo_client_hub_dev
TEST_DATABASE_URL=postgresql://appsolo:appsolo_local_only@localhost:5432/appsolo_client_hub_test
# Test-only API switch used by Playwright; keep false for normal development.
APPSOLO_USE_TEST_DATABASE=false
# Optional when reusing generic DB_HOST/DB_PORT/DB_USER/DB_PASSWORD values.
APPSOLO_DB_NAME=appsolo_client_hub_dev
