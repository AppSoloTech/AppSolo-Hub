{
  "name": "@appsolo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" }, "./seed": { "types": "./dist/seed.d.ts", "default": "./dist/seed.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts",
    "test:prepare": "APPSOLO_DB_NAME=appsolo_client_hub_test tsx src/reset.ts"
  },
  "dependencies": {
    "@appsolo/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.3",
    "pg": "^8.16.3"
  },
  "devDependencies": { "@types/pg": "^8.15.4", "drizzle-kit": "^0.31.4" }
}
